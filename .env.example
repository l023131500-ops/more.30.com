# חיבור למסד הנתונים (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key>
NEXT_PUBLIC_SITE_URL=https://<domain>

# גישת שרת למסלולי API שאין בהם משתמש מחובר (מערכת קולית, נדרים פלוס).
# אפשרות א: מפתח שירות ישיר
# SUPABASE_SERVICE_ROLE_KEY=<service role key>
# אפשרות ב: חשבון שירות שמוגדר כמנהל
IGUD_SERVICE_EMAIL=service@igud.local
IGUD_SERVICE_PASSWORD=<password>

# סוכן AI קולי (רשות). ללא מפתח, החיפוש הקולי עובד בהתאמת מילים.
# ANTHROPIC_API_KEY=<key>
